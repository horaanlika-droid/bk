# Telegram bot token from @BotFather
BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to receive orders / use admin commands
ADMIN_IDS=
# Public HTTPS address of the Telegram Mini App; enables a blue launch button
APP_URL=
# Optional (default 3001)
PORT=3001
# No password for the /staff team page: it is opened from the bot and Telegram
# confirms the user. ADMIN_IDS are the main admins; more admins are added in the
# bot itself — menu → «👥 Админы» → «➕ Добавить админа».
