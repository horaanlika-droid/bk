# Telegram bot token from @BotFather
BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to receive orders / use /orders
ADMIN_IDS=
# Optional (default 3001)
PORT=3001
# Optional emergency access to the /staff team page (login: admin) while the
# bot is not set up. Leave empty in production: personal accounts are issued
# by an admin with /adduser in the bot.
STAFF_PIN=
